# GitHub PAT with read:packages scope — required to install @navikt/* packages from GitHub Packages
# Create one at https://github.com/settings/tokens and select "read:packages"
NODE_AUTH_TOKEN=your_github_pat_here

# Local development mode - bypasses TokenX/OBO authentication
LOCAL_DEV=true
LOCAL_DEV_EMAIL=lokal.utvikler@nav.no

# Backend configuration
TPT_BACKEND_URL=http://localhost:8080

# Backend cache duration in seconds (default: 300 = 5 minutes)
BACKEND_CACHE_SECONDS=300

# Telemetry configuration (optional)
TELEMETRY_URL=https://telemetry.nav.no/collect
