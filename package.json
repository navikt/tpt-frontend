{
  "name": "tpt-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mocks": "MOCKS_ENABLED=true next dev",
    "dev:local": "LOCAL_DEV=true next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky"
  },
  "dependencies": {
    "@grafana/faro-web-sdk": "^2.12.1",
    "@grafana/faro-web-tracing": "^2.12.1",
    "@navikt/aksel-icons": "^8.19.2",
    "@navikt/ds-css": "^8.19.2",
    "@navikt/ds-react": "^8.19.2",
    "@navikt/oasis": "^4.2.2",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "^2.11.28",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "biome lint --write",
      "vitest run --bail=1 --passWithNoTests"
    ]
  }
}
